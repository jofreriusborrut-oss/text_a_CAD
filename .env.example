# Copy this file to ".env" and fill it in. ".env" is never uploaded to git.

# How to talk to Claude:
#   cli -> uses "claude -p" (Claude Code, your Pro/Max subscription, no API cost)
#   api -> uses the Anthropic API (pay per use, needs ANTHROPIC_API_KEY)
CLAUDE_BACKEND=cli

# Model used to generate the CadQuery code
CLAUDE_MODEL=claude-sonnet-5-5

# Only needed when CLAUDE_BACKEND=api
ANTHROPIC_API_KEY=

# Optional: full path to the claude executable if it is not on PATH
# CLAUDE_CLI_PATH=C:\Users\you\AppData\Roaming\npm\claude.cmd

# Seconds allowed for each CadQuery execution and each Claude call
EXEC_TIMEOUT=30
CLAUDE_TIMEOUT=180
