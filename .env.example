# Copy this file to ".env" and fill it in. ".env" is never uploaded to git.

# How to talk to Claude:
#   cli -> uses "claude -p" (Claude Code, your Pro/Max subscription, no API cost)
#   api -> uses the Anthropic API (pay per use, needs ANTHROPIC_API_KEY)
CLAUDE_BACKEND=cli

# Model that writes the CadQuery scripts
CLAUDE_MODEL=claude-sonnet-5-5

# Only needed when CLAUDE_BACKEND=api
ANTHROPIC_API_KEY=

# Optional: full path to the claude executable if it is not on PATH
# CLAUDE_CLI_PATH=C:\Users\you\.local\bin\claude.exe

# Seconds allowed for each CadQuery execution and each Claude call
EXEC_TIMEOUT=30
CLAUDE_TIMEOUT=300

# How many times Claude may try (first answer + corrections) for each message
MAX_ATTEMPTS=4

# Optional: where the designs are saved (default: sortida/sessions in this folder)
# SESSIONS_DIR=C:\Users\you\Documents\TextACAD
